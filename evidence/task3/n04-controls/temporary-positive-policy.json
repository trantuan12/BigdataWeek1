{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "task3-outsider-positive-control",
    "namespace": "bd-g01"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "objects"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "task3-outsider"
              }
            },
            "podSelector": {
              "matchLabels": {
                "access": "s3"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8333
          }
        ]
      }
    ]
  }
}