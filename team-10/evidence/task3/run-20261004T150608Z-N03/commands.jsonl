{"exit_code":0,"name":"N03-owner","stdin":"import datetime, json, socket, sys, time\nhost = sys.argv[1]\nfor port in (8333, 8888):\n    start = time.monotonic()\n    result = dict(host=host, port=port, utc=datetime.datetime.now(datetime.timezone.utc).isoformat())\n    try:\n        with socket.create_connection((host, port), timeout=3):\n            result[\u0027tcp_connected\u0027] = True\n    except OSError as error:\n        result.update(tcp_connected=False, error=type(error).__name__, detail=str(error))\n    result[\u0027seconds\u0027] = time.monotonic() - start\n    print(json.dumps(result), flush=True)","arguments":["--context","minikube","--namespace","bd-g01","--request-timeout=15s","exec","-i","owner","--","python","-","10.244.120.85"],"utc":"2026-10-04T15:06:12.2859925Z","executable":"kubectl"}
